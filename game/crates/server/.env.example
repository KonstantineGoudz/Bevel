# Copy to .env and fill in. Never commit .env.
#
# --- SurrealDB root (compose only; bootstrap + backups) ---
# DEV ONLY default. Generate a real one for anything shared:
#   openssl rand -base64 32
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=devrootpass
SURREAL_PORT=6000

# --- Auth provider (swap without code or schema change) ---
# One of: rauthy | firebase | oidc | hs256 | none
# See src/auth.rs for the full env table.
# The row rules and DEFINE ACCESS in schema.surql are derived from this,
# not from a hard-coded project. `rauthy` is the self-hosted default
# (see rauthy.cfg.example + docker-compose.yml).
DUNGEON_AUTH_PROVIDER=rauthy

# Firebase (when DUNGEON_AUTH_PROVIDER=firebase)
# Your project id from the Firebase console, e.g. my-dungeon-12345.
# Table rules pin iss=https://securetoken.google.com/<id> and aud=<id>.
# Legacy `FIREBASE_PROJECT_ID` is still read for backward compat.
DUNGEON_FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Rauthy self-hosted (when DUNGEON_AUTH_PROVIDER=rauthy) — default for local compose.
# Rauthy runs at http://localhost:6080 (browser) and http://rauthy:6080 (inside compose).
# The sim + SurrealDB verify tokens via the internal JWKS URL.
# See rauthy.cfg.example for the server's own config (PUB_URL, ENC_KEYS, etc.).
DUNGEON_RAUTHY_URL=http://localhost:6080
DUNGEON_RAUTHY_ISSUER=http://localhost:6080/auth/v1
DUNGEON_RAUTHY_AUDIENCE=party-dungeon
DUNGEON_RAUTHY_JWKS_URL=http://rauthy:6080/auth/v1/oidc/jwks

# Generic OIDC (when DUNGEON_AUTH_PROVIDER=oidc)
# Works for Auth0, Clerk, Supabase Auth, Okta, etc. — any provider that
# exposes a JWKS and issues iss/aud/sub.
# DUNGEON_OIDC_ISSUER=https://my-tenant.auth0.com/
# DUNGEON_OIDC_AUDIENCE=my-api
# DUNGEON_OIDC_JWKS_URL=https://my-tenant.auth0.com/.well-known/jwks.json
# DUNGEON_OIDC_ACCESS_NAME=platform_jwt

# Local HS256 (when DUNGEON_AUTH_PROVIDER=hs256) — for tests / dev without
# an external IdP. The server never hard-codes a secret; you provide it.
# DUNGEON_JWT_SECRET=dev-secret
# DUNGEON_JWT_ISSUER=my-iss
# DUNGEON_JWT_AUDIENCE=my-aud

# --- Database selection (namespace + database are created on first use) ---
DUNGEON_SURREAL_NS=party_dungeon
DUNGEON_SURREAL_DB=main

# --- App / service connections (spot the URL form: host:port, no scheme) ---
DUNGEON_SURREAL_URL=127.0.0.1:6000
# The provider's token — Firebase ID token, Auth0 access token, etc.
# The client sends this in `ClientMsg::Hello { token }`; the sim and
# SurrealDB verify it via the provider's JWKS (or HS256 secret for dev).
# For Firebase, this is the ID token from `firebase.auth().currentUser.getIdToken()`.
DUNGEON_TOKEN=your-jwt-here

# --- Rauthy self-hosted IdP (when DUNGEON_AUTH_PROVIDER=rauthy) ---
# These are read by the `rauthy` service in docker-compose.yml. For any
# shared env, generate fresh ENC_KEYS: `openssl rand -base64 32`
RAUTHY_PUB_URL=http://localhost:6080
RAUTHY_PORT=6080
RAUTHY_ENC_KEYS=a9s8f7g6h5j4k3l2m1n0p9o8i7u6y5t4r3e2w1q0a==
RAUTHY_ADMIN_EMAIL=admin@party.dungeon
RAUTHY_ADMIN_PASSWORD_PLAIN=admin123

# --- In-game signup (sim-mediated, no SMTP needed) ---
# Rauthy admin API key, needs Users create+update rights.
# Create in Rauthy admin UI → API Keys. Empty = signup endpoint disabled.
# IMPORTANT: keys are `name$secret`, and docker compose interpolates `$` in
# env_file values — escape it as `$$` here, e.g. `RAUTHY_API_KEY=service$$AAAB…`
# (the sim converts `$$` back to `$`).
RAUTHY_API_KEY=
# OIDC client secret for the sim's login/refresh proxy. Needed only for a
# CONFIDENTIAL Rauthy client (recommended: the secret never ships to the game).
# Empty => clients call Rauthy directly (public client only).
# Passwords follow Rauthy's policy: 8+ chars with upper, lower, digit, special.
RAUTHY_CLIENT_SECRET=
DUNGEON_RAUTHY_CLIENT_ID=party-dungeon
# Optional invite gate for the alpha. Empty = open signup.
DUNGEON_SIGNUP_CODE=
# Internal Rauthy base as seen from the sim container.
DUNGEON_RAUTHY_INTERNAL=http://rauthy:6080

# --- Service user for the trusted sidecar (created by bootstrap.sh) ---
DUNGEON_SERVICE_USER=service
DUNGEON_SERVICE_PASS=change-me-in-prod
